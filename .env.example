# Local development only. Copy to .env before starting Docker Compose.
DJANGO_SETTINGS_MODULE=bobai.settings
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
TIME_ZONE=Asia/Kolkata
WEB_PORT=8000
POSTGRES_DB=bobai_hr
POSTGRES_USER=bobai_hr
POSTGRES_PASSWORD=bobai-local-db
REDIS_PASSWORD=bobai-local-redis
# Used ONLY to enter the first-run setup wizard, not to log in as an admin.
DB_INIT_PASSWORD=bobai-local-setup
